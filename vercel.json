{
  "redirects": [
    {
      "source": "/tecnologias/:path*",
      "destination": "/servicos",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sobre",
      "destination": "/index.html"
    },
    {
      "source": "/servicos",
      "destination": "/index.html"
    },
    {
      "source": "/projetos",
      "destination": "/index.html"
    },
    {
      "source": "/contato",
      "destination": "/index.html"
    }
  ]
}
